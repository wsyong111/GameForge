<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
	<Properties>
		<Property name="pattern">[%d{HH:mm:ss.SSS}] [%-5level] [%X{classLoader}/%t] [%logger{1.}] %msg%n</Property>
	</Properties>

	<Appenders>
		<Console name="Console" target="SYSTEM_OUT" follow="true" direct="false">
			<PatternLayout pattern="${pattern}"/>
		</Console>

		<Async name="AsyncConsole">
			<AppenderRef ref="Console"/>
		</Async>

